# Кастрюлька API — скопируйте в /opt/kastryulka/server/.env и заполните. Файл .env не коммитить!
YOOKASSA_SHOP_ID=          # ЮKassa → Настройки → Магазин → shopId
YOOKASSA_SECRET_KEY=       # ЮKassa → Интеграция → Ключи API (test_... для теста, live_... для боевых платежей)
TG_BOT_TOKEN=              # токен @sytoplan_bot (проверка initData + уведомления «Доступ открыт до …»)
ACCESS_TOKEN_SECRET=       # длинная случайная строка: openssl rand -hex 32 (подпись токенов веб-пользователей)
DB_PATH=/opt/kastryulka/data/kastr.sqlite
PRICE_RUB=590.00
ACCESS_DAYS=30
APP_URL=https://utemov28-lang.github.io/sytoplan/
ALLOWED_ORIGINS=https://utemov28-lang.github.io   # через запятую; добавьте свой домен, если появится
SEND_RECEIPT=1             # 1 — передавать чек 54-ФЗ через ЮKassa; 0 — если чеки выбиваете сами (напр. «Мой налог»)
VAT_CODE=1                 # 1 = без НДС (самозанятые/УСН)
TAX_SYSTEM_CODE=           # обычно пусто; нужен, если в ЮKassa несколько систем налогообложения
REMINDERS=1                # напоминание в Telegram за 3 дня до конца доступа
